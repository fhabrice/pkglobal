# LiteSpeed / Apache: serve the admin page and its assets at the URLs used
# by the site. Keep these rules before any catch-all rewrite rules.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^admin/?$ public/admin/index.html [L]
RewriteRule ^admin/(admin\.(?:js|css))$ public/admin/$1 [L]
</IfModule>
