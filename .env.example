# Required in all environments. Generate a unique secret with at least 32 characters.
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
PORT=3000

# Required for production/normal deployments: provisions the first Super Administrator.
# Never commit real values. Keep these set on the deployment platform, not in source control.
INITIAL_ADMIN_NAME=PK Global Super Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Local development only. Set true to enable the built-in demo roles/accounts.
# This setting is ignored when NODE_ENV=production.
ALLOW_DEMO_USERS=false

# SMTP email delivery. Configure these with your provider credentials to send real emails.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=notifications@example.com
MAIL_PASSWORD=replace-with-your-smtp-password
MAIL_FROM=PK Global Partners <notifications@example.com>

# Optional Supabase integration
SUPABASE_URL=
SUPABASE_KEY=
